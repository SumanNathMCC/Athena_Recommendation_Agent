    "ChunkHitWeight": 0.35,
    "RecencyWeight": 0.15,
    "RecencyTauDays": 730,
    "NearDuplicateCeiling": 0.97,
    "DefaultLambda": 0.7,
    "ChunkHitTopK": 20
  },
  "Agent": {
    "PromptFile": "Agents/AthenaResearchLibrarian.md"
  }
}
