@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Diagnostics
@using System.Text
@using Athena.Agent
@using Athena.Retrieval
@using Athena.Web.Components.Shared
@inject AthenaChatSession ChatSession

<PageTitle>Athena</PageTitle>

<div class="chat-layout">
    <div class="chat-shell">
        <header class="chat-header">
            <h1>Athena</h1>
            <p class="text-muted mb-0">Research librarian — grounded answers from retrieved corpus passages.</p>
        </header>

        <section class="chat-messages" aria-live="polite">
            @foreach (var message in _messages)
            {
                <div class="chat-message @message.Role">
                    <div class="chat-bubble">
                        <strong>@(message.Role == ChatRole.User ? "You" : "Athena")</strong>
                        @if (message.Role == ChatRole.User)
                        {
                            <p class="chat-plain">@message.Text</p>
                        }
                        else if (message.IsStreaming)
                        {
                            @if (string.IsNullOrEmpty(message.Text))
                            {
                                <p class="text-muted mb-0">Searching the corpus…</p>
                            }
                            else
                            {
                                <p class="chat-plain streaming-text">@message.Text<span class="stream-caret" aria-hidden="true"></span></p>
                            }
                        }
                        else
                        {
                            <MarkdownContent Text="@message.Text" CssClass="chat-md" />
                        }
                    </div>
                </div>
            }
        </section>

        <div class="chat-input-row">
            <input class="form-control"
                   placeholder="Ask about the research library…"
                   value="@_draft"
                   @oninput="OnDraftInput"
                   @onkeydown="OnDraftKeyDown"
                   disabled="@_isBusy"
                   aria-label="Message" />
            <button class="btn btn-primary"
                    type="button"
                    disabled="@(_isBusy || string.IsNullOrWhiteSpace(_draft))"
                    @onclick="SendMessage">
                Send
            </button>
        </div>

        <p class="chat-hint text-muted">
            Answers use hybrid retrieval over injected chunks. Ensure documents are Injected on
            <a href="corpus">Corpus setup</a>
            (re-inject after app restart — vectors are in-memory).
        </p>
    </div>

    <aside class="retrieval-sidebar" aria-label="Retrieved chunks">
        <header class="retrieval-sidebar-header">
            <h2>Retrieved chunks</h2>
            <p class="text-muted mb-0">
                Final passages after dense + lexical + RRF + rerank
                @if (_passages.Count > 0)
                {
                    <span>(@_passages.Count)</span>
                }
            </p>
        </header>

        @if (_isBusy && _passages.Count == 0)
        {
            <p class="text-muted retrieval-empty">Retrieving…</p>
        }
        else if (_passages.Count == 0)
        {
            <p class="text-muted retrieval-empty">
                No chunks yet. Ask a corpus question and the passages used for the answer will appear here.
            </p>
        }
        else
        {
            <ol class="retrieval-list">
                @foreach (var passage in _passages)
                {
                    <li class="retrieval-card">
                        <div class="retrieval-card-meta">
                            <span class="retrieval-title">@passage.Title</span>
                            <span class="retrieval-badges">
                                <span class="retrieval-chip">@passage.DocId</span>
                                <span class="retrieval-chip">p.@passage.PageNumber</span>
                                <span class="retrieval-chip">score @passage.Score.ToString("F3")</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(passage.Section))
                        {
                            <div class="retrieval-section text-muted">@passage.Section</div>
                        }
                        <MarkdownContent Text="@passage.Text" CssClass="retrieval-md" />
                        <div class="retrieval-chunk-id text-muted">@passage.ChunkId</div>
                    </li>
                }
            </ol>
        }
    </aside>
</div>

@code {
    private readonly List<ChatMessage> _messages =
    [
        new(ChatRole.Assistant,
            "Welcome. Ask a factual question about the research corpus and I will retrieve passages, then answer from them. " +
            "Inject documents on the Corpus page first if you have not already.")
    ];

    private readonly List<Passage> _passages = [];
    private string _draft = string.Empty;
    private bool _isBusy;

    private void OnDraftInput(ChangeEventArgs e)
    {
        _draft = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnDraftKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (_isBusy || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var userText = _draft.Trim();
        _draft = string.Empty;
        _messages.Add(new ChatMessage(ChatRole.User, userText));

        var assistant = new ChatMessage(ChatRole.Assistant, string.Empty) { IsStreaming = true };
        _messages.Add(assistant);

        _passages.Clear();
        _isBusy = true;
        await InvokeAsync(StateHasChanged);

        var sb = new StringBuilder();
        var uiClock = Stopwatch.StartNew();
        const int uiThrottleMs = 40;

        try
        {
            await foreach (var delta in ChatSession.StreamAsync(userText))
            {
                sb.Append(delta);
                assistant.Text = sb.ToString();

                if (_passages.Count == 0)
                {
                    SyncPassages();
                }

                if (uiClock.ElapsedMilliseconds >= uiThrottleMs)
                {
                    await InvokeAsync(StateHasChanged);
                    uiClock.Restart();
                }
            }

            assistant.Text = string.IsNullOrWhiteSpace(sb.ToString())
                ? "I could not produce a reply. Ensure the corpus is injected and Azure Foundry is configured."
                : sb.ToString().Trim();
            SyncPassages();
        }
        catch (Exception ex)
        {
            assistant.Text = $"Sorry — I hit an error: {ex.Message}";
        }
        finally
        {
            assistant.IsStreaming = false;
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SyncPassages()
    {
        var latest = ChatSession.GetLastPassages();
        if (latest.Count == 0)
        {
            return;
        }

        _passages.Clear();
        _passages.AddRange(latest);
    }

    private enum ChatRole
    {
        User,
        Assistant
    }

    private sealed class ChatMessage
    {
        public ChatMessage(ChatRole role, string text)
        {
            Role = role;
            Text = text;
        }

        public ChatRole Role { get; }
        public string Text { get; set; }
        public bool IsStreaming { get; set; }
    }
}
