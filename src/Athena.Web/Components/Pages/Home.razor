@page "/"
@rendermode InteractiveServer
@using Athena.Agent
@inject AthenaChatSession ChatSession

<PageTitle>Athena</PageTitle>

<div class="chat-shell">
    <header class="chat-header">
        <h1>Athena</h1>
        <p class="text-muted mb-0">Research librarian — grounded answers from retrieved corpus passages.</p>
    </header>

    <section class="chat-messages" aria-live="polite">
        @foreach (var message in _messages)
        {
            <div class="chat-message @message.Role">
                <div class="chat-bubble">
                    <strong>@(message.Role == ChatRole.User ? "You" : "Athena")</strong>
                    <p style="white-space: pre-wrap">@message.Text</p>
                </div>
            </div>
        }
        @if (_isBusy)
        {
            <div class="chat-message assistant">
                <div class="chat-bubble">
                    <strong>Athena</strong>
                    <p class="text-muted mb-0">Searching the corpus…</p>
                </div>
            </div>
        }
    </section>

    <form class="chat-input-row" @onsubmit="SendMessage" @onsubmit:preventDefault="true">
        <input class="form-control"
               placeholder="Ask about the research library…"
               @bind="_draft"
               disabled="@_isBusy"
               aria-label="Message" />
        <button class="btn btn-primary" type="submit" disabled="@_isBusy || string.IsNullOrWhiteSpace(_draft)">
            Send
        </button>
    </form>

    <p class="chat-hint text-muted">
        Answers use hybrid retrieval over injected chunks. Ensure documents are Injected on
        <a href="corpus">Corpus setup</a>
        (re-inject after app restart — vectors are in-memory).
    </p>
</div>

@code {
    private readonly List<ChatMessage> _messages =
    [
        new(ChatRole.Assistant,
            "Welcome. Ask a factual question about the research corpus and I will retrieve passages, then answer from them. " +
            "Inject documents on the Corpus page first if you have not already.")
    ];

    private string _draft = string.Empty;
    private bool _isBusy;

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var userText = _draft.Trim();
        _draft = string.Empty;
        _messages.Add(new ChatMessage(ChatRole.User, userText));
        _isBusy = true;
        try
        {
            var reply = await ChatSession.SendAsync(userText);
            _messages.Add(new ChatMessage(ChatRole.Assistant, reply));
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage(
                ChatRole.Assistant,
                $"Sorry — I hit an error: {ex.Message}"));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private enum ChatRole
    {
        User,
        Assistant
    }

    private sealed record ChatMessage(ChatRole Role, string Text);
}
