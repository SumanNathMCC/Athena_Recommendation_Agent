@page "/"
@rendermode InteractiveServer

<PageTitle>Athena</PageTitle>

<div class="chat-shell">
    <header class="chat-header">
        <h1>Athena</h1>
        <p class="text-muted mb-0">Research librarian — grounded answers and reading recommendations.</p>
    </header>

    <section class="chat-messages" aria-live="polite">
        @foreach (var message in _messages)
        {
            <div class="chat-message @message.Role">
                <div class="chat-bubble">
                    <strong>@(message.Role == ChatRole.User ? "You" : "Athena")</strong>
                    <p>@message.Text</p>
                </div>
            </div>
        }
    </section>

    <form class="chat-input-row" @onsubmit="SendMessage" @onsubmit:preventDefault="true">
        <input class="form-control"
               placeholder="Ask about the research library…"
               @bind="_draft"
               disabled="@_isBusy"
               aria-label="Message" />
        <button class="btn btn-primary" type="submit" disabled="@_isBusy || string.IsNullOrWhiteSpace(_draft)">
            Send
        </button>
    </form>

    <p class="chat-hint text-muted">
        Agent routing is not wired yet. Use
        <a href="corpus">Corpus setup</a>
        to download PDFs before ingestion.
    </p>
</div>

@code {
    private readonly List<ChatMessage> _messages =
    [
        new(ChatRole.Assistant,
            "Welcome. I will answer from your research corpus once ingestion and the agent are connected. " +
            "Start by fetching the PDFs from the Corpus page.")
    ];

    private string _draft = string.Empty;
    private bool _isBusy;

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var userText = _draft.Trim();
        _draft = string.Empty;
        _messages.Add(new ChatMessage(ChatRole.User, userText));
        _isBusy = true;

        await Task.Delay(300);

        _messages.Add(new ChatMessage(
            ChatRole.Assistant,
            "The chat agent is not connected yet. Complete corpus fetch, then ingestion, retrieval, and agent wiring."));
        _isBusy = false;
    }

    private enum ChatRole
    {
        User,
        Assistant
    }

    private sealed record ChatMessage(ChatRole Role, string Text);
}
