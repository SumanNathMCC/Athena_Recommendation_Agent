@page "/corpus"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ICorpusSetupService CorpusSetupService
@implements IAsyncDisposable

<PageTitle>Corpus Setup</PageTitle>

<h3>Corpus setup</h3>

<p class="text-muted">
    Select documents below, then download, extract, or inject only those rows.
</p>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="status">
        @_statusMessage
    </div>
}

@if (_summary is not null)
{
    <p class="fw-semibold">@_summary</p>
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <h5 class="mb-0">Document pipeline status</h5>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small">@_selectedDocIds.Count / @_documents.Count selected</span>
        <button class="btn btn-sm btn-outline-secondary"
                type="button"
                disabled="@(_isRunning || _documents.Count == 0 || AllSelected)"
                @onclick="SelectAll">
            Select all
        </button>
        <button class="btn btn-sm btn-outline-secondary"
                type="button"
                disabled="@(_isRunning || _selectedDocIds.Count == 0)"
                @onclick="UnselectAll">
            Unselect all
        </button>
        <button class="btn btn-sm btn-outline-primary"
                type="button"
                disabled="@_isRunning"
                @onclick="RefreshStatusAsync">
            Refresh status
        </button>
    </div>
</div>

@if (_documents.Count == 0 && !_isLoadingStatus)
{
    <p class="text-muted">No documents found in the corpus manifest.</p>
}
else if (_isLoadingStatus && _documents.Count == 0)
{
    <p class="text-muted">Loading status…</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th style="width: 2.5rem">
                        <input type="checkbox"
                               class="form-check-input"
                               checked="@AllSelected"
                               disabled="@(_isRunning || _documents.Count == 0)"
                               @onclick="ToggleSelectAllClick"
                               @onclick:preventDefault="true"
                               title="Select / unselect all"
                               aria-label="Select or unselect all documents" />
                    </th>
                    <th>Doc ID</th>
                    <th>File</th>
                    <th>Download</th>
                    <th>Extract</th>
                    <th>Inject</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in _documents)
                {
                    var isSelected = _selectedDocIds.Contains(document.DocId);
                    <tr class="@(isSelected ? "table-active" : null)">
                        <td>
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@isSelected"
                                   disabled="@_isRunning"
                                   @onclick="() => ToggleDocClick(document.DocId)"
                                   @onclick:preventDefault="true"
                                   aria-label="@($"Select {document.DocId}")" />
                        </td>
                        <td>@document.DocId</td>
                        <td><code>@document.LocalFile</code></td>
                        <td>@StageBadge(document.Download)</td>
                        <td>@StageBadge(document.Extract)</td>
                        <td>@StageBadge(document.Inject)</td>
                        <td class="small text-muted">@FormatDetails(document)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="card mb-4">
    <div class="card-header fw-semibold">1. Download</div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Fetch selected research PDFs from <code>corpus/manifest.json</code> into <code>corpus/pdfs/</code>.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary"
                    disabled="@ActionsDisabled"
                    @onclick="() => RunFetchAsync(force: false)">
                @ButtonLabel("Fetch selected", _currentOperation == Operation.Fetch)
            </button>
            <button class="btn btn-outline-secondary"
                    disabled="@ActionsDisabled"
                    @onclick="() => RunFetchAsync(force: true)">
                @ButtonLabel("Force re-download selected", _currentOperation == Operation.FetchForce)
            </button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">2. Extract (Azure Document Intelligence)</div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Extract prose and tables via <code>prebuilt-layout</code> into section-structured Markdown under <code>corpus/extracted/</code>
            for the selected documents.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary"
                    disabled="@ActionsDisabled"
                    @onclick="() => RunExtractAsync(force: false)">
                @ButtonLabel("Extract selected", _currentOperation == Operation.Extract)
            </button>
            <button class="btn btn-outline-secondary"
                    disabled="@ActionsDisabled"
                    @onclick="() => RunExtractAsync(force: true)">
                @ButtonLabel("Force re-extract selected", _currentOperation == Operation.ExtractForce)
            </button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">3. Inject (chunk + summarise + embed)</div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Chunk, summarise, and embed the selected documents into the in-memory vector store.
            Requires <code>AzureFoundry</code> settings.
        </p>
        <div class="mb-3">
            <label class="form-label" for="chunkingStrategy">Chunking strategy</label>
            <select id="chunkingStrategy"
                    class="form-select"
                    disabled="@_isRunning"
                    @bind="_chunkingStrategy">
                <option value="@ChunkingStrategy.SectionAware">Section-aware (default)</option>
                <option value="@ChunkingStrategy.FixedWindow">Fixed window (1000 tokens, 20% overlap)</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="docVectorStrategy">Document vector strategy</label>
            <select id="docVectorStrategy"
                    class="form-select"
                    disabled="@_isRunning"
                    @bind="_docVectorStrategy">
                <option value="@DocumentVectorStrategyKind.Summary">Summary embedding (default)</option>
                <option value="@DocumentVectorStrategyKind.Centroid">Centroid of chunk embeddings</option>
                <option value="@DocumentVectorStrategyKind.Composite">Composite (title + topics + summary)</option>
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary"
                    disabled="@ActionsDisabled"
                    @onclick="() => RunInjectAsync(force: false)">
                @ButtonLabel("Inject selected", _currentOperation == Operation.Inject)
            </button>
            <button class="btn btn-outline-secondary"
                    disabled="@ActionsDisabled"
                    @onclick="() => RunInjectAsync(force: true)">
                @ButtonLabel("Force re-inject selected", _currentOperation == Operation.InjectForce)
            </button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">Run all</div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Force download, extract, and inject the selected documents in one pass.
        </p>
        <button class="btn btn-warning"
                disabled="@ActionsDisabled"
                @onclick="RunFullPipelineAsync">
            @ButtonLabel("Force download + extract + inject selected", _currentOperation == Operation.FullPipeline)
        </button>
    </div>
</div>

@code {
    private enum Operation
    {
        None,
        Fetch,
        FetchForce,
        Extract,
        ExtractForce,
        Inject,
        InjectForce,
        FullPipeline
    }

    private bool _isRunning;
    private bool _isLoadingStatus = true;
    private bool _isError;
    private string? _statusMessage;
    private string? _summary;
    private Operation _currentOperation = Operation.None;
    private ChunkingStrategy _chunkingStrategy = ChunkingStrategy.SectionAware;
    private DocumentVectorStrategyKind _docVectorStrategy = DocumentVectorStrategyKind.Summary;
    private List<CorpusDocPipelineStatus> _documents = [];
    private readonly HashSet<string> _selectedDocIds = new(StringComparer.OrdinalIgnoreCase);

    private bool ActionsDisabled => _isRunning || _selectedDocIds.Count == 0;

    private bool AllSelected =>
        _documents.Count > 0 && _documents.All(document => _selectedDocIds.Contains(document.DocId));

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
        if (_selectedDocIds.Count == 0)
        {
            SelectAll();
        }
    }

    private async Task RefreshStatusAsync()
    {
        _isLoadingStatus = true;
        StateHasChanged();

        try
        {
            _documents = (await CorpusSetupService.GetStatusAsync()).ToList();
            _selectedDocIds.RemoveWhere(id => _documents.All(document =>
                !document.DocId.Equals(id, StringComparison.OrdinalIgnoreCase)));
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isLoadingStatus = false;
        }
    }

    private IReadOnlyList<string> GetSelectedDocIds() => _selectedDocIds.ToList();

    private void SelectAll()
    {
        foreach (var document in _documents)
        {
            _selectedDocIds.Add(document.DocId);
        }
    }

    private void UnselectAll() => _selectedDocIds.Clear();

    private void ToggleSelectAllClick()
    {
        if (AllSelected)
        {
            UnselectAll();
        }
        else
        {
            SelectAll();
        }
    }

    private void ToggleDocClick(string docId)
    {
        if (!_selectedDocIds.Add(docId))
        {
            _selectedDocIds.Remove(docId);
        }
    }

    private Task RunFetchAsync(bool force) =>
        RunOperationAsync(
            force ? Operation.FetchForce : Operation.Fetch,
            async () =>
            {
                var result = await CorpusSetupService.FetchAsync(force, GetSelectedDocIds());
                _summary = $"Download — succeeded: {result.Downloaded}, skipped: {result.Skipped}, failed: {result.Failed}";
                _statusMessage = result.IsSuccess
                    ? "Corpus fetch completed successfully."
                    : "Corpus fetch completed with one or more failures.";
                _isError = !result.IsSuccess;
                await RefreshStatusAsync();
            });

    private Task RunExtractAsync(bool force) =>
        RunOperationAsync(
            force ? Operation.ExtractForce : Operation.Extract,
            async () =>
            {
                var result = await CorpusSetupService.ExtractAsync(force, GetSelectedDocIds());
                _summary = $"Extract — succeeded: {result.Succeeded}, skipped: {result.Skipped}, failed: {result.Failed}";
                _statusMessage = result.IsSuccess
                    ? "Extraction completed successfully."
                    : "Extraction completed with one or more failures.";
                _isError = !result.IsSuccess;
                await RefreshStatusAsync();
            });

    private Task RunInjectAsync(bool force) =>
        RunOperationAsync(
            force ? Operation.InjectForce : Operation.Inject,
            async () =>
            {
                var result = await CorpusSetupService.InjectAsync(
                    force,
                    _chunkingStrategy,
                    _docVectorStrategy,
                    GetSelectedDocIds());
                _summary = $"Inject — succeeded: {result.Succeeded}, skipped: {result.Skipped}, failed: {result.Failed}";
                _statusMessage = result.IsSuccess
                    ? "Injection staging completed successfully."
                    : "Injection staging completed with one or more failures.";
                _isError = !result.IsSuccess;
                await RefreshStatusAsync();
            });

    private Task RunFullPipelineAsync() =>
        RunOperationAsync(
            Operation.FullPipeline,
            async () =>
            {
                var result = await CorpusSetupService.RunFullPipelineAsync(
                    force: true,
                    _chunkingStrategy,
                    _docVectorStrategy,
                    GetSelectedDocIds());
                _summary =
                    $"Full pipeline — download failed: {result.Fetch.Failed}, " +
                    $"extract failed: {result.Extract.Failed}, inject failed: {result.Inject.Failed}";
                _statusMessage = result.IsSuccess
                    ? "Full pipeline completed successfully."
                    : "Full pipeline completed with one or more failures.";
                _isError = !result.IsSuccess;
                await RefreshStatusAsync();
            });

    private async Task RunOperationAsync(Operation operation, Func<Task> action)
    {
        if (_selectedDocIds.Count == 0)
        {
            _isError = true;
            _statusMessage = "Select at least one document first.";
            return;
        }

        _isRunning = true;
        _currentOperation = operation;
        _isError = false;
        _statusMessage = null;
        _summary = null;
        StateHasChanged();

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isRunning = false;
            _currentOperation = Operation.None;
        }
    }

    private static string ButtonLabel(string label, bool isActive) =>
        isActive ? $"{label}…" : label;

    private static RenderFragment StageBadge(PipelineStageStatus status) => builder =>
    {
        var (cssClass, text) = status switch
        {
            PipelineStageStatus.Succeeded => ("bg-success", "Done"),
            PipelineStageStatus.Skipped => ("bg-secondary", "Skipped"),
            PipelineStageStatus.Failed => ("bg-danger", "Failed"),
            PipelineStageStatus.InProgress => ("bg-primary", "Running"),
            PipelineStageStatus.Pending => ("bg-info text-dark", "Pending"),
            _ => ("bg-light text-dark", "Not started")
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cssClass}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static string FormatDetails(CorpusDocPipelineStatus document)
    {
        var parts = new[]
        {
            document.DownloadMessage,
            document.ExtractMessage,
            document.InjectMessage
        }
        .Where(message => !string.IsNullOrWhiteSpace(message));

        return string.Join(" | ", parts);
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
